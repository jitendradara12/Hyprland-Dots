# ~/.config/fish/config.fish: DO NOT EDIT -- this file has been generated
# automatically by home-manager.

# Only execute this file once per shell.
set -q __fish_home_manager_config_sourced; and exit
set -g __fish_home_manager_config_sourced 1

source /nix/store/6mzbxc44l5v6sm0n8z9w2lhmpnpjxf35-hm-session-vars.fish/etc/profile.d/hm-session-vars.fish

# Source handler functions

status is-login; and begin

    # Login shell initialisation

end

status is-interactive; and begin

    # Abbreviations

    # Aliases
    alias :q exit
    alias c clear
    alias d 'exa -a --grid '
    alias dir 'exa -a --grid'
    alias dysk 'dysk -c label+default'
    alias eza 'eza --icons auto --git --group-directories-first --no-quotes --header --git-ignore --classify --hyperlink'
    alias jctl 'journalctl -p 3 -xb'
    alias la 'eza -lah '
    alias ll 'eza  -a --no-user --long'
    alias lla 'eza -la'
    alias ls eza
    alias lsbc 'lsblk -f | bat -l conf -p '
    alias lt 'eza --tree --level=2'
    alias man batman
    alias ncg 'nix-collect-garbage --delete-old && sudo nix-collect-garbage -d && sudo /run/current-system/bin/switch-to-configuration boot'
    alias notes 'nvim ~/notes.txt'
    alias notes2 'nvim ~/notes2.txt'
    alias serie 'serie -p kitty --preload -g double'
    alias sv 'sudo nvim'
    alias tree 'eza --tree '
    alias v nvim
    alias zi cdi

    # Interactive shell initialisation
    # add completions generated by Home Manager to $fish_complete_path
    begin
        set -l joined (string join " " $fish_complete_path)
        set -l prev_joined (string replace --regex "[^\s]*generated_completions.*" "" $joined)
        set -l post_joined (string replace $prev_joined "" $joined)
        set -l prev (string split " " (string trim $prev_joined))
        set -l post (string split " " (string trim $post_joined))
        set fish_complete_path $prev "/home/sastauser/.local/share/fish/home-manager/generated_completions" $post
    end

end
