 /* wallust template - colors-rofi */

* {
active-background: #5B768B;
active-foreground: #E6EDF3;
normal-background: #1D1F21;
normal-foreground: #E6EDF3;
urgent-background: #ADC4D5;
urgent-foreground: #E6EDF3;

alternate-active-background: #3A4A55;
alternate-active-foreground: #E6EDF3;
alternate-normal-background: #1D1F21;
alternate-normal-foreground: #E6EDF3;
alternate-urgent-background: #1D1F21;
alternate-urgent-foreground: #E6EDF3;

selected-active-background: #ADC4D5;
selected-active-foreground: #E6EDF3;
selected-normal-background: #ADC4D5;
selected-normal-foreground: #E6EDF3;
selected-urgent-background: #ADC4D5;
selected-urgent-foreground: #E6EDF3;

background-color: #1D1F21;
background: rgba(0,0,0,0.7);
foreground: #E6EDF3;
border-color: #5B768B;

color0: #434548;
color1: #131A21;
color2: #1E252B;
color3: #2B373F;
color4: #445868;
color5: #8293A0;
color6: #899AA6;
color7: #D2DDE6;
color8: #939BA1;
color9: #1A232C;
color10: #28313A;
color11: #3A4A55;
color12: #5B768B;
color13: #ADC4D5;
color14: #B6CDDE;
color15: #D2DDE6;


}

