 /* wallust template - colors-rofi */

* {
active-background: #E8D3BC;
active-foreground: #ECF7F8;
normal-background: #1B1C1E;
normal-foreground: #ECF7F8;
urgent-background: #E2D5CD;
urgent-foreground: #ECF7F8;

alternate-active-background: #EDCFAF;
alternate-active-foreground: #ECF7F8;
alternate-normal-background: #1B1C1E;
alternate-normal-foreground: #ECF7F8;
alternate-urgent-background: #1B1C1E;
alternate-urgent-foreground: #ECF7F8;

selected-active-background: #E2D5CD;
selected-active-foreground: #ECF7F8;
selected-normal-background: #E2D5CD;
selected-normal-foreground: #ECF7F8;
selected-urgent-background: #E2D5CD;
selected-urgent-foreground: #ECF7F8;

background-color: #1B1C1E;
background: rgba(0,0,0,0.7);
foreground: #ECF7F8;
border-color: #E8D3BC;

color0: #424245;
color1: #947F87;
color2: #AF9983;
color3: #B29C84;
color4: #AE9E8D;
color5: #A9A09A;
color6: #98ADB1;
color7: #DCEBED;
color8: #9AA4A6;
color9: #C5A9B4;
color10: #EACCAF;
color11: #EDCFAF;
color12: #E8D3BC;
color13: #E2D5CD;
color14: #CAE7EC;
