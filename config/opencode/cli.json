{
  "$schema": "https://opencode.ai/v2/cli.json",
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "prompt": {
    "paste": "compact"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "terminal": true,
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": false,
    "new_location": "launch"
  },
  "animations": true,
  "tabs": {
    "enabled": false,
    "scope": "cwd",
    "layout": "vertical",
    "indicators": "numbers"
  },
  "scroll": {
    "speed": 3.25
  },
  "attention": {
    "enabled": true,
    "notifications": false
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": false
  },
  "theme": {
    "name": "opencode"
  },
  "mouse": true
}
