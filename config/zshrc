# minimal zshrc for path exports, Claude/AWS variables, and local settings

# opencode & local PATH settings
export PATH="$HOME/.opencode/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:$HOME/go/bin"

# Claude Code / Bedrock environment variables
export CLAUDE_CODE_USE_BEDROCK=1
export AWS_REGION="us-east-1" 
export ANTHROPIC_MODEL="anthropic.claude-sonnet-4-6-v1"

# Source local settings if they exist (useful for machine-specific configs/credentials)
if [ -f "$HOME/.zshrc.local" ]; then
    source "$HOME/.zshrc.local"
fi

# Enable vi command line editing mode (vi keybindings)
bindkey -v
