// ### DEFAULT Laptop  - Bottom (me) ### //
{
	"include": [
	  "$HOME/.config/waybar/Modules",
	  "$HOME/.config/waybar/ModulesWorkspaces",
	  "$HOME/.config/waybar/ModulesCustom",
	  "$HOME/.config/waybar/ModulesGroups",
	  "$HOME/.config/waybar/UserModules",
	  ],
	"layer": "top",
	//"mode": "dock",
	"exclusive": true,
	"passthrough": false,
	"position": "bottom",
	"spacing": 3,
	"fixed-center": true,
	"ipc": true,
	"margin-top": 0,
	"margin-left": 8,
	"margin-right": 8,
	
	"modules-left": [
		"custom/separator#blank",
		"hyprland/workspaces#rw",
		"custom/separator#dot-line",
		"group/mobo_drawer",
		"custom/separator#blank_2",
	],
	
	"modules-center": [
		"clock",
	],
	
	"modules-right": [
		"network#speed",
		"tray",
		"custom/separator#dot-line",
		"group/laptop",
		"custom/separator#dot-line",
		"group/audio",
		"custom/separator#dot-line",
		"custom/power",
	],
}
